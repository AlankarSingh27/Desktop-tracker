NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/emp_tracker

# JWT
JWT_ADMIN_SECRET=change_this_to_a_long_random_string_admin
JWT_AGENT_SECRET=change_this_to_a_long_random_string_agent
JWT_ADMIN_EXPIRES_IN=8h
JWT_AGENT_EXPIRES_IN=30d

# CORS - dashboard origin
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Agent enrollment secret (given to IT admins only, used to enroll new devices)
AGENT_ENROLLMENT_SECRET=change_this_enrollment_secret

# Screenshots
# how long a screenshot is kept before the cleanup job deletes it from
# both Cloudinary and MongoDB
SCREENSHOT_RETENTION_DAYS=30

# Cloudinary (screenshot storage - sign up free at cloudinary.com, no card
# needed; values come from your Cloudinary dashboard's "API Environment
# variable" box)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# How long activity data (sessions, keystroke/click metrics, downloads, idle
# logs) is kept before MongoDB auto-deletes it via TTL index
DATA_RETENTION_DAYS=3
