{
  "name": "emp-tracker-agent",
  "version": "1.0.0",
  "description": "Employee activity monitoring agent for company-owned laptops (consent-based)",
  "main": "dist/main/main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "tsc -p tsconfig.json && node copy-assets.js && electron .",
    "build": "tsc -p tsconfig.json && node copy-assets.js",
    "build:installer": "npm run build && cross-env ELECTRON_BUILDER_CACHE=C:\\Users\\Administrator\\AppData\\Local\\electron-builder\\Cache electron-builder",
    "start": "electron ."
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "axios": "^1.7.4",
    "cors": "^2.8.5",
    "electron-store": "^8.2.0",
    "express": "^4.19.2",
    "form-data": "^4.0.0",
    "node-machine-id": "^1.1.12",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "cross-env": "^10.1.0",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4"
  },
  "build": {
    "appId": "com.company.emp-tracker-agent",
    "productName": "Company Activity Agent",
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
