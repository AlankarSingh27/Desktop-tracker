# Copy to .env in this same directory before running `docker compose up`

# --- Backend secrets (generate long random strings for these) ---
JWT_ADMIN_SECRET=change_this_to_a_long_random_string_admin
JWT_AGENT_SECRET=change_this_to_a_long_random_string_agent
JWT_ADMIN_EXPIRES_IN=8h
JWT_AGENT_EXPIRES_IN=30d

# Secret given only to IT admins to enroll new agent devices
AGENT_ENROLLMENT_SECRET=change_this_enrollment_secret

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Cross-service URLs ---
# CORS_ORIGIN must match wherever the dashboard is actually served from
CORS_ORIGIN=http://localhost:8080

# Baked into the dashboard build at build time (Vite) - the browser's
# address for the backend, NOT the internal docker network address
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
